mdp
const double q = 0.8;
const double p;
const allowance = 20;

module chain

	s : [0..10] init 0;
	
    [a] true -> 0.5 : (s'=min(s+1,10)) + 0.5 : (s'=0);
	[b] true -> p : (s'=min(s+1,10)) + 1-p : (s'=0);
	[c] true -> q : (s'=min(s+1,10)) + 1-q : (s'=0);

endmodule

rewards
	[a] true : allowance - 1;
	[b] true : allowance - 1;
	[c] true : allowance - 1;
endrewards

label "goal" = (s=10);