mdp

const int M = 10; // represents starting amount
const int MAX_MONEY = 100;
const int STAGES = 8; // number of stages

// Uncertain parameters
const double p_11; // original 0.7 - low p_win

module game
    m:[0..MAX_MONEY] init M; // represents current money
    s:[1..STAGES+1] init 1; // current stage

    // Betting transitions
    [zero] m <= 0 & (s < STAGES) ->  (s'=min(s+1, STAGES)) & (m'=m);
    [one] m > 0 & (s < STAGES)-> p_11:(s'=min(s+1, STAGES)) & (m'=min(m+1, MAX_MONEY)) + (1-p_11): (s'=min(s+1, STAGES)) & (m'=max(m-1,0));
    [two] m > 1 & (s < STAGES)-> p_11:(s'=min(s+1, STAGES)) & (m'=min(m+2, MAX_MONEY)) + (1-p_11): (s'=min(s+1, STAGES)) & (m'=max(m-2,0));
    [five] m > 4 & (s < STAGES)-> p_11:(s'=min(s+1, STAGES)) & (m'=min(m+5, MAX_MONEY)) + (1-p_11): (s'=min(s+1, STAGES)) & (m'=max(m-5,0));
    [ten] m > 10 & (s < STAGES)-> p_11:(s'=min(s+1, STAGES)) & (m'=min(m+10, MAX_MONEY)) + (1-p_11): (s'=min(s+1, STAGES)) & (m'=max(m-10,0));
    [end] s=(STAGES) -> (s'=s+1);
endmodule

label "goal" = (s=STAGES+1);
label "obs" = (m=0);

rewards
    [end] s=STAGES : m;
endrewards