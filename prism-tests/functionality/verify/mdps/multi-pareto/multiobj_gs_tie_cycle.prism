// Regression test for a Gauss-Seidel tie-break oscillation bug in the explicit
// engine's multi-objective weighted-sum solver (found by random stress-testing
// against the symbolic engine). Under -ex -gs, the weight vector explored during
// Pareto-curve refinement for this model has two choices exactly tied on the
// combined weighted value, but each better than the other on a different
// individual objective (r1 vs r2). The greedy tie-break used to re-decide the
// tie every sweep, and feeding back one choice's values made the other look
// better next sweep and vice versa, forming a stable 2-cycle: the combined
// value converged immediately but the individual objective values oscillated
// forever, so -ex -gs never terminated ("Iterative method did not converge").
// Fixed by freezing the policy once the combined value converges, rather than
// re-litigating already-tied choices every sweep.
mdp

module m
	x : [0..3] init 0;

	[s0_0] x=0 -> 2/2:(x'=1);
	[s0_1] x=0 -> 4/9:(x'=3) + 1/9:(x'=1) + 4/9:(x'=0);
	[s0_2] x=0 -> 5/12:(x'=0) + 3/12:(x'=3) + 4/12:(x'=1);
	[s1_0] x=1 -> 3/7:(x'=3) + 4/7:(x'=2);
	[s1_1] x=1 -> 2/2:(x'=3);
	[s1_2] x=1 -> 1/4:(x'=3) + 3/4:(x'=0);
	[s2_0] x=2 -> 5/10:(x'=0) + 3/10:(x'=1) + 2/10:(x'=3);
	[s2_1] x=2 -> 5/5:(x'=3);
	[done_loop] x=3 -> 1/1:(x'=3);
endmodule

rewards "r1"
	[s0_0] true : 3;
	[s0_2] true : 3;
	[s1_0] true : 1;
	[s1_1] true : 1;
	[s1_2] true : 3;
	[s2_0] true : 2;
	[s2_1] true : 1;
endrewards

rewards "r2"
	[s0_1] true : 3;
	[s0_2] true : 1;
	[s1_0] true : 3;
	[s1_1] true : 3;
	[s1_2] true : 1;
	[s2_0] true : 1;
endrewards
